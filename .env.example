DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/inventory"
# Minimal 32 karakter acak. Buat dengan: node -p "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET="isi-dengan-string-acak-minimal-32-karakter"
# Satu origin atau beberapa dipisah koma. "*" = semua origin (khusus development).
# Contoh produksi: CORS_ORIGIN="https://pos-invent.vercel.app,http://localhost:5173"
CORS_ORIGIN="*"